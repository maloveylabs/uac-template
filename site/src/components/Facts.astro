---
interface Props {
  items: { label: string; value?: string }[]
}

const items = Astro.props.items.filter((item) => item.value)
---

{
  items.length > 0 && (
    <dl class="facts">
      {items.map((item) => (
        <div>
          <dt class="label muted">{item.label}</dt>
          <dd>{item.value}</dd>
        </div>
      ))}
    </dl>
  )
}
