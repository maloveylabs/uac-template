---
import { toHTML } from '@portabletext/to-html'
import type { PortableTextBlock } from '@portabletext/to-html'

interface Props {
  value?: PortableTextBlock[]
  class?: string
}

const { value, class: className = 'prose' } = Astro.props

const html = value?.length
  ? toHTML(value, {
      components: {
        marks: {
          link: ({ value, children }) =>
            `<a href="${value?.href}" rel="noopener" target="_blank">${children}</a>`,
        },
      },
    })
  : ''
---

{html && <div class={className} set:html={html} />}
