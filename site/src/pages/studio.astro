---
import Base from '@/layouts/Base.astro'
import Reel from '@/components/Reel.astro'
import { getSettings, getWorks } from '@/lib/queries'
import { forSide } from '@/lib/works'

// Wording on this page. Change the text between the quotes.
const COPY = {
  title: 'Studio',
  empty: 'Studio work is coming soon.',
  more: 'See all work',
}

const [settings, works] = await Promise.all([getSettings(), getWorks()])
const { shown, hasMore } = forSide(works, 'studio')
---

<Base title={COPY.title} section="studio" image={shown[0]?.images?.[0]}>
  <Reel
    works={shown}
    settings={settings}
    empty={COPY.empty}
    more={hasMore ? COPY.more : undefined}
  />
</Base>
